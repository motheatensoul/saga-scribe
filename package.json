{
	"name": "saga-scribe",
	"private": true,
	"version": "0.6.0",
	"type": "module",
	"scripts": {
		"licenses": "bun scripts/third-party-licenses.ts",
		"build:grammar": "lezer-generator src/lib/parser/tei-dsl.grammar -o src/lib/parser/tei-dsl-parser.js",
		"dev": "bun run build:grammar && vite dev",
		"build": "bun run build:grammar && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:rust": "cd src-tauri && cargo clippy -- -D warnings",
		"check:all": "bun run check && bun run check:rust",
		"test:rust": "cd src-tauri && cargo test",
		"test:js": "vitest run",
		"test": "bun run test:js && bun run test:rust",
		"clean": "rm -rf node_modules/.vite .svelte-kit",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"flatpak:build": "bash flatpak/build-flatpak.sh",
		"flatpak:bundle": "flatpak build-bundle flatpak-repo saga-scribe.flatpak app.sagascribe.Sagascribe"
	},
	"devDependencies": {
		"@lezer/generator": "^1.8.1",
		"@sveltejs/adapter-static": "^4",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24",
		"autoprefixer": "^10.6.2",
		"jsdom": "^30.1.3",
		"postcss": "^8.5.32",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@lucide/svelte": "^0.562.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@vivliostyle/core": "2.45.2",
		"codemirror": "^6.0.2",
		"daisyui": "^5.7.50",
		"dompurify": "^3.4.17",
		"svelte-splitpanes": "^8.0.12"
	},
	"overrides": {
		"@codemirror/view": "^6.39.11",
		"@codemirror/state": "^6.5.4"
	}
}
