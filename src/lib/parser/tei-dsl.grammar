// TEI-DSL Lezer Grammar
// Syntax highlighting grammar for manuscript transcription DSL.
//
// Tokens come from tokens.ts, which finds them exactly as the compiler's
// parser does (src-tauri/src/parser/syntax.rs); corpus.test.ts checks both
// against the shared corpus in tests/fixtures/dsl-corpus.json.

@top Document { element* }

element {
  WordContinuationPageBreak |
  WordContinuationLineBreak |
  PageBreak |
  LineBreak |
  ParagraphBreak |
  Head |
  Abbreviation |
  SuppliedBlock |
  NormBlock |
  Gap |
  Supplied |
  Deletion |
  Addition |
  Note |
  Unclear |
  Entity |
  WordBoundary |
  CompoundJoin |
  Text
}

// .head{heading text}
Head { headKeyword BlockContent }

// .abbr[abbreviated]{expansion}
Abbreviation { abbrKeyword BracketContent BraceContent }

// .supplied{supplied text}
SuppliedBlock { suppliedKeyword BlockContent }

// .norm{normalized-only content}
NormBlock { normKeyword BlockContent }

@external tokens dslTokens from "./tokens" {
  // ~///n and ~//n: a word continued across a page or line break
  WordContinuationPageBreak,
  WordContinuationLineBreak,
  // ///n, //n
  PageBreak,
  LineBreak,
  // .p (standalone) starts a new paragraph
  ParagraphBreak,
  headKeyword,
  abbrKeyword,
  suppliedKeyword,
  normKeyword,
  // {...} of a block, [...] and {...} of an abbreviation
  BlockContent,
  BracketContent,
  BraceContent,
  // [...], [...n], [...<text>], [...n<text>]
  Gap,
  // <text>
  Supplied,
  // -{text}-
  Deletion,
  // +{text}+
  Addition,
  // ^{text}
  Note,
  // ?{text}?
  Unclear,
  // :name:
  Entity,
  // |
  WordBoundary,
  // ~ between word parts (upp~haf → upphaf in norm)
  CompoundJoin,
  Text
}
