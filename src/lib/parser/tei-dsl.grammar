// TEI-DSL Lezer Grammar
// Syntax highlighting grammar for manuscript transcription DSL.
//
// Tokens come from tokens.ts, which finds them exactly as the compiler's
// parser does (src-tauri/src/parser/syntax.rs); corpus.test.ts checks both
// against the shared corpus in tests/fixtures/dsl-corpus.json.

@context markupContext from "./tokens"

@top Document { element* }

element {
  WordContinuationColumnBreak |
  WordContinuationPageBreak |
  WordContinuationLineBreak |
  ColumnBreak |
  PageBreak |
  LineBreak |
  ParagraphBreak |
  Head |
  Abbreviation |
  SuppliedBlock |
  NormBlock |
  Gap |
  Supplied |
  Deletion |
  Addition |
  Note |
  Unclear |
  Entity |
  Expansion |
  Literal |
  Numeral |
  Markup |
  HandShift |
  Space |
  WordBoundary |
  CompoundJoin |
  Text
}

// .head{heading text}
Head { headKeyword BlockContent }

// .abbr[abbreviated]{expansion}
Abbreviation { abbrKeyword BracketContent BraceContent }

// .supplied{supplied text}
SuppliedBlock { suppliedKeyword BlockContent }

// .norm{normalized-only content}
NormBlock { normKeyword BlockContent }

// .q{…}, *{…}*, &{…}, ${…}, .rdg[A]{…}; a pair: .corr{sic=corr}
Markup { MarkupOpen element* (MarkupMiddle element*)? MarkupClose }

@external tokens dslTokens from "./tokens" {
  // ~///c=n, ~///n and ~//n: a word continued across a column, page or line break
  WordContinuationColumnBreak,
  WordContinuationPageBreak,
  WordContinuationLineBreak,
  // ///c=n, ///n, //n
  ColumnBreak,
  PageBreak,
  LineBreak,
  // .p (standalone) starts a new paragraph
  ParagraphBreak,
  headKeyword,
  abbrKeyword,
  suppliedKeyword,
  normKeyword,
  // {...} of a block, [...] and {...} of an abbreviation
  BlockContent,
  BracketContent,
  BraceContent,
  // [...], [...n], [...<text>], [...n<text>]
  Gap,
  // <text>
  Supplied,
  // -{text}-
  Deletion,
  // +{text}+
  Addition,
  // ^{text}
  Note,
  // ?{text}?
  Unclear,
  // :name:
  Entity,
  // {mark=expansion}: an abbreviation mark and its expansion
  Expansion,
  // \c: the character c as text
  Literal,
  // #.x.#: a numeral
  Numeral,
  // The start of markup (`.q{`), the `=` of a pair, its end (`}`, `}*`)
  MarkupOpen,
  MarkupMiddle,
  MarkupClose,
  // .hs{hand}
  HandShift,
  // .space[n]
  Space,
  // |
  WordBoundary,
  // ~ between word parts (upp~haf → upphaf in norm)
  CompoundJoin,
  Text
}
